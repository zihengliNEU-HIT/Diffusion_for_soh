{
  "mode": "train",
  "data_dir": "./data",
  "output_dir": "./output",
  "checkpoint_dir": "./checkpoints",
  "batch_size": 16,
  "num_epochs": 260,
  "lr": 0.001,
  "timesteps": 300,
  "eval_interval": 10,
  "save_interval": 10,
  "patience": 30,
  "scheduler": "steplr",
  "step_size": 10,
  "step_gamma": 0.8,
  "noise_schedule": "cosine",
  "cosine_s": 0.008,
  "clip_grad": 1.0,
  "weight_decay": 0.0001,
  "ema": 0.99995,
  "cond_vector_dim": 24,
  "use_ddim": true,
  "ddim_steps": 50,
  "ddim_eta": 0.0,
  "num_workers": 1,
  "num_samples": 16,
  "oversample_tail": true,
  "oversample_tail_factor": 3
}
